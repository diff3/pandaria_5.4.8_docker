# ======================
# Paths & Directories
# ======================

# Where binaries, configs, and runtime files are installed
INSTALL_PREFIX=/app
CUSTOM_DIR="/app/custom_conf"

# Source code location
SOURCE_PREFIX=/src/pandaria_5.4.8

# Directory for maps, vmaps, mmaps, and dbc files
DATA_DIR_PATH=/app/data
ETC_DIR_PATH=/app/etc

# Directory for server logs
LOGS_DIR_PATH=/app/logs

# SQL directories
SQL_DIR=/app/sql
SQL_FIXES_DIR=/app/custom_sql/fixes
SQL_CUSTOM_DIR=/app/custom_sql/custom

# Local World of Warcraft MoP client path
WOW_PATH=/home/magnus/Games/World of Warcraft MoP

# Mounted client path inside container
WOW_INTERNAL="/app/wow"

# Client locale for realmlist/config edits (e.g., enGB, enUS)
WOW_LOCALE=enGB

# ======================
# Docker & Container Config
# ======================

# Whether to use external DB (true) or start internal DB container (false)
EXTERNAL_DB=true

# Timezone for containers
TIMEZONE=Europe/Stockholm

# Container and image naming
CONTAINER_NAME=pandaria
IMAGE_NAME=pandaria
OS_NAME=debian12-slim

# Network ports
AUTH_PORT=3724
REALM_ADDRESS=192.168.11.30
REALM_PORT=8085
RA_PORT=3443
SOAP_PORT=7878
PHPADMIN_PORT=8080

# ======================
# Build & Compile Options
# ======================

# Compiler settings
CMAKE_C_COMPILER=/usr/bin/clang-14
CMAKE_CXX_COMPILER=/usr/bin/clang++-14
CMAKE_CXX_FLAGS=-pthread

# Script support: static or dynamic
SCRIPTS=static

# Show warnings during build (0 = off, 1 = on)
WARNINGS=0

# Build map/vmap/mmaps extractors (1 = yes, 0 = no)
EXTRACTORS=1

# Run "make install" after build (1 = yes, 0 = just build)
MAKE_INSTALL=1

# ======================
# Database Settings
# ======================

# MariaDB container name
DB_CONTAINER=mysql

# Database host and port (external or internal)
DB_HOST=192.168.11.81
DB_PORT=3306

# Root MySQL credentials
MYSQL_USERNAME=root
MYSQL_PASSWORD=pwd

# Game server database user credentials
SERVER_DB_USER=pandaria
SERVER_DB_PASSWORD=pwd

# Database names
AUTH_DB=pandaria548_auth
WORLD_DB=pandaria548_world
CHARACTER_DB=pandaria548_characters

# ======================
# SQL File References
# ======================

# Base SQL files
AUTH_SQL=auth_04_03_2023.sql
CHARACTER_SQL=characters_29_12_2024.sql
WORLD_SQL=world_04_03_2023.sql

# World DB source (zip file + update)
REPO_URL=https://github.com/alexkulya/pandaria_5.4.8.git
WORLD_DB_URL=https://github.com/alexkulya/pandaria_5.4.8/releases/download/%23pandaria548world/2024_08_01_world.zip
WORLD_DB_ZIP=/app/sql/latest_world.zip
WORLD_SQL_UPDATE=/app/sql/2024_08_01_world.sql

# ======================
# Data Extraction Options
# ======================

# Enable or disable extraction of maps/vmaps/mmaps
MAPS=ON
VMAPS=ON
MMAPS=ON

# ======================
# Worldserver Configuration
# ======================

# Server game type (0 = Normal, 6 = RP, etc.)
GAME_TYPE=0

# Realm zone (1 = Development)
REALM_ZONE=1

# Message of the day
MOTD_MSG="Welcome to Pandaria 5.4.8"

# Realm information
REALM_NAME=Pandaria 5.4.8
REALM_ICON=1
REALM_COLOR=0
REALM_TIMEZONE=1
REALM_SECURITY=0
REALM_POP=0
REALM_BUILD=18414
REALM_FLAG=0

# Remote administration (RA) and SOAP settings
RA_ENABLE=1
SOAP_ENABLE=0
SOAP_IP=0.0.0.0
CONSOLE=0